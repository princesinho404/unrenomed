local function atualizarListaNavegacao(manterNome)
    listaDeRotas = {}
    for nome, _ in pairs(rotasSalvas) do
        table.insert(listaDeRotas, nome)
    end
    
    table.sort(listaDeRotas)

    if #listaDeRotas == 0 then
        table.insert(listaDeRotas, "Nenhuma")
    end

    if manterNome and rotasSalvas[manterNome] then
        for idx, nome in ipairs(listaDeRotas) do
            if nome == manterNome then
                indiceRotaAtual = idx
                break
            end
        end
    else
        if indiceRotaAtual > #listaDeRotas then 
            indiceRotaAtual = #listaDeRotas 
        elseif indiceRotaAtual < 1 then
            indiceRotaAtual = 1
        end
    end
    
    rotaSelecionada = listaDeRotas[indiceRotaAtual] or "Nenhuma"
    atualizarVisorNaUI()
end

