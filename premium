end

local function deletarArquivoRota(nomeRota)
    if delfile and isfile then
        pcall(function()
            local caminho = NOME_PASTA .. "/" .. limparNomeArquivo(nomeRota) .. ".json"
            if isfile(caminho) then
                delfile(caminho)
            end
        end)
    end
end

local function carregarArquivosIniciais()
    rotasSalvas = {}
    if listfiles and readfile and isfolder and isfolder(NOME_PASTA) then
        pcall(function()
            local arquivos = listfiles(NOME_PASTA)
            for _, arq in ipairs(arquivos) do
                if string.match(arq, "%.json$") then
                    local ok, conteudo = pcall(function() return readfile(arq) end)
                    if ok and conteudo then
                        local okJson, dados = pcall(function() return HttpService:JSONDecode(conteudo) end)
                        if okJson and dados and dados.dados then
                            local nomeSalvo = dados.nomeRota or string.gsub(arq, "^.*[/\\]", ""):gsub("%.json$", "")
                            rotasSalvas[nomeSalvo] = dados
                        end
                    end
                end
            end
        end)
    end
end

