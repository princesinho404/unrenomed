end

local function temFerramenta(nome)
    local char = LocalPlayer.Character
    local bp = LocalPlayer.Backpack
    if char and bp then
        if char:FindFirstChild(nome) then return true end
        local f = bp:FindFirstChild(nome)
        if f then 
            f.Parent = char 
            task.wait(0.1) 
            return true 
        end
    end
    return false
end

-- Corrigido com a coordenada exata da Foice (-355, 3, -625)
local function pegarFoice()
    if temFerramenta("Foice") then return true end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        hrp.CFrame = CFrame.new(-355, 3, -625)
        task.wait(0.6)
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled then
                local partePai = obj.Parent
                if partePai and partePai:IsA("BasePart") then
                    if (partePai.Position - Vector3.new(-355, 3, -625)).Magnitude < 10 then
                        if fireproximityprompt then fireproximityprompt(obj) end
                        task.wait(0.6)
                        break
                    end
                end
            end
        end
    end
    
    return temFerramenta("Foice")
end

local function obterTrofeusColetaveis()
    local lista = {}
    pcall(function()
        local pasta = workspace:FindFirstChild("Map") and workspace.Map.Sistemas:FindFirstChild("Miss\195\163o") and workspace.Map.Sistemas["Miss\195\163o"]:FindFirstChild("Trof\195\169us")
        if pasta then
            for i = 1, 10 do
                local t = pasta:FindFirstChild("Trof\195\169u" .. i) or pasta:FindFirstChild("Trofeu" .. i)
                if t then
                    local prompt = t:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt and prompt.Enabled then table.insert(lista, t) end
                end
            end
        end
    end)
    return lista
end

local function iniciarAutoMissao()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then posicaoInicialMissao = hrp.CFrame end
    travarCameraCima()
    
    task.spawn(function()
        while autoMissaoAtivo do
            local mData = LocalPlayer:FindFirstChild("Miss\195\181esData") or LocalPlayer:FindFirstChild("MissoesData")
            if not mData then break end
            
            local mAtual = mData:FindFirstChild("Miss\195\163oAtual")
            if not mAtual then break end
            
            local nomeMissao = string.lower(mAtual.Value)
            local vTrofeu = mData:FindFirstChild("Trof\195\169us") and mData["Trof\195\169us"].Value or 0
            local vGrama = mData:FindFirstChild("GramasCortadas") and mData.GramasCortadas.Value or 0
            local vLixo = mData:FindFirstChild("LixosRecolhidos") and mData.LixosRecolhidos.Value or 0
            
            local metaGrama, metaLixo, metaTrofeu = 150, 150, 10
            if string.find(nomeMissao, "pra\195\167a") then metaGrama = 30; metaLixo = 15; metaTrofeu = 0
            elseif string.find(nomeMissao, "diretor") then metaGrama = 100; metaLixo = 40; metaTrofeu = 5 end
            
            local executouAcao = false
            local charAtual = LocalPlayer.Character
            local hrpAtual = charAtual and charAtual:FindFirstChild("HumanoidRootPart")
            
            if hrpAtual then
                if metaTrofeu > 0 and vTrofeu < metaTrofeu then
                    executouAcao = true
                    local listaTrofeus = obterTrofeusColetaveis()
                    if #listaTrofeus > 0 then
                        local t = listaTrofeus[1]
                        hrpAtual.CFrame = t.CFrame * CFrame.new(0, 1.5, 0)
                        task.wait(0.25)
                        if fireproximityprompt then fireproximityprompt(t:FindFirstChildWhichIsA("ProximityPrompt", true)) end
                    end
                elseif metaGrama > 0 and vGrama < metaGrama then
                    executouAcao = true
                    pegarFoice()
                    local gramasPasta = workspace:FindFirstChild("Map") and workspace.Map.Sistemas.Jobs["Cortar Grama"].Gramas
                    if gramasPasta then
                        for _, grama in ipairs(gramasPasta:GetChildren()) do
                            local prompt = grama:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if prompt and prompt.Enabled then
                                local alvo = grama:IsA("BasePart") and grama or grama:FindFirstChildWhichIsA("BasePart")
                                if alvo and alvo.Transparency < 0.9 then
                                    hrpAtual.CFrame = alvo.CFrame * CFrame.new(0, 3, 0)
                                    task.wait(0.2)
                                    if prompt.Enabled and fireproximityprompt then fireproximityprompt(prompt) end
                                    break
                                end
                            end
                        end
                    end
                end
            end
            if not executouAcao then break end
            task.wait(0.1)
        end
        autoMissaoAtivo = false
        restaurarCamera()
        if posicaoInicialMissao and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = posicaoInicialMissao
        end
    end)
end

