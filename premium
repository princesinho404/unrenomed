local function dispararTecla(keycode)
    pcall(function()
        VIM:SendKeyEvent(true, keycode, false, game)
        task.wait(0.01)
        VIM:SendKeyEvent(false, keycode, false, game)
    end)
end

local function cliqueVirtualFisico(button)
    if not button then return end
    pcall(function()
        firesignal(button.MouseButton1Down)
        firesignal(button.MouseButton1Click)
        firesignal(button.TouchTap)
        button:Activate()
        
        local x = button.AbsolutePosition.X + (button.AbsoluteSize.X / 2)
        local y = button.AbsolutePosition.Y + (button.AbsoluteSize.Y / 2)
        
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.01)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
end

DevSec:addToggle("Ativar auto JJS", false, function(state)
    autoJJSEnabled = state
    
    if autoJJSEnabled then
        -- Se for 0 ou menor, define a meta limite como matemática infinita
        local metaAlvo = (quantidadeMaxima > 0) and quantidadeMaxima or math.huge
        local textoMeta = (metaAlvo == math.huge) and "Infinito" or tostring(metaAlvo)

        contadorAtual = 0
        UI:Notify("Iniciado", "Iniciando JJS... Meta: " .. textoMeta)

        task.spawn(function()
            local processados = {}

            while autoJJSEnabled and contadorAtual < metaAlvo do
                pcall(function()
                    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local poli = pGui and pGui:FindFirstChild("Polichinelos")
                    local screen = poli and poli:FindFirstChild("Screen")

                    if screen and autoJJSEnabled then
                        for _, botao in ipairs(screen:GetChildren()) do
                            if botao:IsA("ImageButton") and botao.Visible and not processados[botao] then
                                if not botao:GetAttribute("Completed") then
                                    local label = botao:FindFirstChildWhichIsA("TextLabel")
                                    
                                    if label and label.Text and label.Text ~= "" then
                                        local textoLetra = tostring(label.Text):upper():gsub("%s+", "")
                                        processados[botao] = true
                                        
                                        if not UIS.TouchEnabled and keyMap[textoLetra] then
                                            dispararTecla(keyMap[textoLetra])
                                        else
                                            cliqueVirtualFisico(botao)
                                        end
                                        
                                        local remote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Polichinelos")
                                        if remote then
                                            remote:FireServer("Add", 1)
                                        end

                                        contadorAtual = contadorAtual + 1
                                        task.wait(delaySegundos)
                                        break
                                    end
                                end
                            end
                        end
                    end
                end)

                if typeof(processados) == "table" and #processados > 15 then
                    table.clear(processados)
                end

                task.wait(0.01)
            end

            -- Notifica conclusão apenas se havia uma meta numérica definida
            if autoJJSEnabled and metaAlvo ~= math.huge and contadorAtual >= metaAlvo then
                autoJJSEnabled = false
                UI:Notify("Concluído", "Atingiu a meta de " .. metaAlvo .. " JJS!")
            end
        end)
    else
        UI:Notify("Pausado", "Auto JJS parado.")
    end
end)

