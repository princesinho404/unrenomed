-- 🚀 SISTEMA DE PLAYBACK BLINDADO (FIX DO BOTÃO DE RUN)
--------------------------------------------------------------------
local function iniciarPlayback(slot)
    if not slot or not slot.dados or #slot.dados == 0 then
        pcall(function() UI:Notify("Erro", "Sem dados na rota selecionada!") end)
        return 
    end
    
    reproduzindo = false
    task.wait(0.05)

    slotAtivo = slot
    tempoDecorrido = 0

    local pStart = slot.posicaoStart
    local pPrimeiro = slot.dados[1]
    
    local posAlvoExata = Vector3.new(pStart[1] + pPrimeiro.offX, pStart[2] + pPrimeiro.offY, pStart[3] + pPrimeiro.offZ)
    local targetCF = CFrame.new(posAlvoExata) * CFrame.fromEulerAnglesYXZ(0, pPrimeiro.rotY, 0)

    local offsetPe = (humanoid and humanoid.HipHeight) and (humanoid.HipHeight + (rootPart.Size.Y / 2)) or 3.0
    local destinoChao = posAlvoExata - Vector3.new(0, offsetPe, 0)

    local dist = (rootPart.Position - posAlvoExata).Magnitude

    if configSecurity and dist > 50 then
        pcall(function() UI:Notify("Segurança", "Muito longe (+" .. math.floor(dist) .. " studs). Cancelado!") end)
        slotAtivo = nil
        return
    end

    local velAtual = humanoid.WalkSpeed
    humanoid.WalkSpeed = 16

    if dist > 1.2 and dist < 35 then
        humanoid:MoveTo(destinoChao)
        
        local t0 = os.clock()
        while true do
            local distXZ = (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(posAlvoExata.X, 0, posAlvoExata.Z)).Magnitude
            
            if distXZ <= 1.2 or (os.clock() - t0) >= 2.5 then
                break
            end
            task.wait()
        end
        
        humanoid:MoveTo(rootPart.Position)
        
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        humanoid.AutoRotate = false 
        
        local tw = TweenService:Create(rootPart, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = targetCF})
        tw:Play()
        task.wait(0.2) 
        
        humanoid.AutoRotate = true
    else
        character:PivotTo(targetCF)
    end

    humanoid.WalkSpeed = velAtual

    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero

    if delayInicio > 0 then
        pcall(function() UI:Notify("TAS", "Aguardando delay: " .. delayInicio .. "s") end)
        task.wait(delayInicio)
    end

    task.defer(function()
        reproduzindo = true
    end)
    
    pcall(function() UI:Notify("TAS", "Reproduzindo Rota!") end)
end

