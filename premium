local function desenharRota3D(slotDados, corLinha)
    if not slotDados or not slotDados.dados or #slotDados.dados < 2 then return nil end

    local pastaSlot = Instance.new("Folder", pastaLinhas)
    pastaSlot.Name = "PathVisualizer"
    corLinha = corLinha or Color3.fromRGB(140, 90, 255)
    local posInicio = Vector3.new(slotDados.posicaoStart[1], slotDados.posicaoStart[2], slotDados.posicaoStart[3])

    local offsetPe = (humanoid and humanoid.HipHeight) and (humanoid.HipHeight + (rootPart.Size.Y / 2)) or 3.0

    if character then
        character.Archivable = true
        local clone = character:Clone()
        character.Archivable = false
        if clone then
            clone.Name = "StartGhost"
            
            local ghostRoot = clone:FindFirstChild("HumanoidRootPart") or clone:FindFirstChild("Torso") or clone:FindFirstChild("UpperTorso")
            if ghostRoot then
                clone.PrimaryPart = ghostRoot
            end

            local pPrimeiro = slotDados.dados[1]
            local posStartActual = posInicio + Vector3.new(pPrimeiro.offX, pPrimeiro.offY, pPrimeiro.offZ)
            local targetCF = CFrame.new(posStartActual) * CFrame.fromEulerAnglesYXZ(0, pPrimeiro.rotY, 0)
            
            clone:PivotTo(targetCF)

            for _, item in ipairs(clone:GetDescendants()) do
                if item:IsA("LocalScript") or item:IsA("Script") or item:IsA("Animator") then
                    item:Destroy()
                end
                if item:IsA("BasePart") then
                    item.Anchored = true
                    item.CanCollide = false
                    item.CanTouch = false 
                    item.CanQuery = false 
                    item.Transparency = (item.Name == "HumanoidRootPart") and 1 or 0.5
                end
            end
            
            local hum = clone:FindFirstChildOfClass("Humanoid")
            if hum then 
                hum.PlatformStand = true 
                hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None 
            end
            
            clone.Parent = pastaSlot
        end
    end

    local pontosRender = {}
    local ultimoPontoRender = nil
    
    for i = 1, #slotDados.dados do
        local p = slotDados.dados[i]
        local posAtual = posInicio + Vector3.new(p.offX, p.offY - offsetPe, p.offZ)
        
        if not ultimoPontoRender or (ultimoPontoRender - posAtual).Magnitude >= 0.6 or i == #slotDados.dados then
            table.insert(pontosRender, posAtual)
            ultimoPontoRender = posAtual
        end
    end

    for i = 1, #pontosRender - 1 do
        local p1 = pontosRender[i]
        local p2 = pontosRender[i+1]
        local distancia = (p1 - p2).Magnitude
        
        if distancia > 0.05 then
            local linha = Instance.new("Part", pastaSlot)
            linha.Name = "Trilha"
            linha.Anchored = true
            linha.CanCollide = false
            linha.CanTouch = false
            linha.CanQuery = false
            linha.Material = Enum.Material.Neon
            linha.Color = corLinha
            linha.Size = Vector3.new(0.15, 0.15, distancia)
            linha.CFrame = CFrame.lookAt(p1, p2) * CFrame.new(0, 0, -distancia / 2)
            linha.Transparency = 0.3
        end
    end

    return pastaSlot
end

