-- 🎬 REPRODUTOR DE TRAJETO (SISTEMA HAVAC)
--------------------------------------------------------------------
local reproduzindo = false
local emTransicao = false
local tempoDecorrido = 0
local slotAtivo = nil

RunService.PostSimulation:Connect(function(deltaTime)
    if reproduzindo and rootPart and humanoid and slotAtivo and not emTransicao then
        tempoDecorrido = tempoDecorrido + deltaTime
        local historico = slotAtivo.dados
        
        local dadosAlvo = nil
        for i = #historico, 1, -1 do
            if historico[i].tempo <= tempoDecorrido then
                dadosAlvo = historico[i]
                break
            end
        end
        
        if tempoDecorrido >= (slotAtivo.tempoTotal or 9999) or not dadosAlvo then
            reproduzindo = false
            humanoid.PlatformStand = false
            slotAtivo = nil
            UI:Notify("Parkour", "Trajeto Concluído!")
        else
            local posX = slotAtivo.posicaoStart[1] + dadosAlvo.offX
            local posY = slotAtivo.posicaoStart[2] + dadosAlvo.offY
            local posZ = slotAtivo.posicaoStart[3] + dadosAlvo.offZ
            
            rootPart.AssemblyLinearVelocity = Vector3.new(dadosAlvo.velX, dadosAlvo.velY, dadosAlvo.velZ)
            rootPart.CFrame = CFrame.new(posX, posY, posZ) * CFrame.fromEulerAnglesYXZ(0, dadosAlvo.rotY, 0)
            
            pcall(function()
                if type(dadosAlvo.estado) == "number" then
                    humanoid:ChangeState(Enum.HumanoidStateType:GetEnumItems()[dadosAlvo.estado + 1])
                elseif type(dadosAlvo.estado) == "string" and Enum.HumanoidStateType[dadosAlvo.estado] then
                    humanoid:ChangeState(Enum.HumanoidStateType[dadosAlvo.estado])
                end
            end)
        end
    end
end)

local function iniciarTrajetoHavac(dadosDoTrajeto)
    if emTransicao then return end

    if reproduzindo then
        reproduzindo = false
        humanoid.PlatformStand = false
        slotAtivo = nil
        UI:Notify("Parkour", "Reprodução interrompida!")
        return
    end

    if dadosDoTrajeto and rootPart and humanoid then
        tempoDecorrido = 0
        local posStart = dadosDoTrajeto.posicaoStart or {rootPart.Position.X, rootPart.Position.Y, rootPart.Position.Z}
        local pontoAlvo = Vector3.new(posStart[1], posStart[2], posStart[3])
        local rotYAlvo = dadosDoTrajeto.dados[1].rotY
        local targetCFrame = CFrame.new(pontoAlvo) * CFrame.fromEulerAnglesYXZ(0, rotYAlvo, 0)
        
        slotAtivo = {
            dados = dadosDoTrajeto.dados,
            posicaoStart = posStart,
            tempoTotal = dadosDoTrajeto.tempoTotal
        }

        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        humanoid:ChangeState(Enum.HumanoidStateType.Running)

        local distancia = (rootPart.Position - pontoAlvo).Magnitude
        if distancia > 0.6 and distancia < 35 then
            emTransicao = true
            humanoid:MoveTo(pontoAlvo)
            
            local chegou = false
            local conexao
            conexao = humanoid.MoveToFinished:Connect(function()
                chegou = true
                conexao:Disconnect()
            end)
            
            local inicioEspera = os.clock()
            while not chegou and (os.clock() - inicioEspera < 2.5) do
                if (rootPart.Position - pontoAlvo).Magnitude <= 1.2 then
                    chegou = true
                    break
                end
                task.wait()
            end
            if conexao.Connected then conexao:Disconnect() end

            humanoid.AutoRotate = false
            local tweenGiro = TweenService:Create(rootPart, TweenInfo.new(0.16, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = targetCFrame})
            tweenGiro:Play()
            tweenGiro.Completed:Wait()
            
            humanoid.AutoRotate = true
            emTransicao = false
        else
            rootPart.CFrame = targetCFrame
        end
        
        humanoid.PlatformStand = true
        reproduzindo = true
        UI:Notify("Parkour", "Reproduzindo Trajeto!")
    end
end

local function executarRotaPorURL(nomeCategoria, versao)
    local url = RAW_URLS[nomeCategoria] and RAW_URLS[nomeCategoria][versao]
    if not url or url == "" or url:sub(1, 4) ~= "http" then
        UI:Notify("Erro", "URL RAW não configurada para " .. nomeCategoria .. " (" .. versao .. ")")
        return
    end

    UI:Notify("Carregando", "Baixando dados RAW...")

    task.spawn(function()
        local sucesso, resposta = pcall(function()
            return game:HttpGet(url)
        end)

        if sucesso and resposta and resposta ~= "" then
            local jsonSucesso, dadosSlot = pcall(function()
                return HttpService:JSONDecode(resposta)
            end)

            if jsonSucesso and dadosSlot then
                if dadosSlot[1] and dadosSlot[1].dados then
                    dadosSlot = dadosSlot[1]
                end
                iniciarTrajetoHavac(dadosSlot)
            else
                UI:Notify("Erro", "JSON malformatado ou inválido.")
            end
        else
            UI:Notify("Erro", "Falha ao conectar no RAW.")
        end
    end)
end

