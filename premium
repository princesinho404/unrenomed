RunService.PostSimulation:Connect(function(deltaTime)
    if not rootPart or not humanoid then return end

    if gravando then
        local deltaReal = gravarEmSlow and (deltaTime * fatorSlow) or deltaTime
        tempoDecorrido = tempoDecorrido + deltaReal
        local _, y, _ = rootPart.CFrame:ToEulerAnglesYXZ()
        local multVel = gravarEmSlow and (1 / fatorSlow) or 1.0

        table.insert(gravacaoTemporaria, {
            tempo = tempoDecorrido,
            velX = rootPart.AssemblyLinearVelocity.X * multVel,
            velY = rootPart.AssemblyLinearVelocity.Y * multVel,
            velZ = rootPart.AssemblyLinearVelocity.Z * multVel,
            estado = humanoid:GetState().Name,
            rotY = y,
            offX = rootPart.Position.X - posicaoInicial.X,
            offY = rootPart.Position.Y - posicaoInicial.Y,
            offZ = rootPart.Position.Z - posicaoInicial.Z
        })

    elseif reproduzindo and slotAtivo then
        tempoDecorrido = tempoDecorrido + deltaTime
        local historico = slotAtivo.dados
        
        local dadosAlvo = historico[1] 

        for i = #historico, 1, -1 do
            if historico[i].tempo <= tempoDecorrido then
                dadosAlvo = historico[i]
                break
            end
        end

        local tempoFinal = slotAtivo.tempoTotal or historico[#historico].tempo

        if tempoDecorrido >= tempoFinal then
            if loopAtivo then
                tempoDecorrido = 0
                rootPart.AssemblyLinearVelocity = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero
                local pIni = historico[1]
                character:PivotTo(CFrame.new(slotAtivo.posicaoStart[1] + pIni.offX, slotAtivo.posicaoStart[2] + pIni.offY, slotAtivo.posicaoStart[3] + pIni.offZ) * CFrame.fromEulerAnglesYXZ(0, pIni.rotY, 0))
            else
                reproduzindo = false
                slotAtivo = nil
                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                pcall(function() UI:Notify("TAS", "Reprodução Concluída!") end)
            end
        else
            local pX = slotAtivo.posicaoStart[1] + dadosAlvo.offX
            local pY = slotAtivo.posicaoStart[2] + dadosAlvo.offY
            local pZ = slotAtivo.posicaoStart[3] + dadosAlvo.offZ

            rootPart.AssemblyLinearVelocity = Vector3.new(dadosAlvo.velX, dadosAlvo.velY, dadosAlvo.velZ)
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = CFrame.new(pX, pY, pZ) * CFrame.fromEulerAnglesYXZ(0, dadosAlvo.rotY, 0)

            pcall(function()
                if dadosAlvo.estado then
                    local stEnum = Enum.HumanoidStateType[dadosAlvo.estado]
                    if stEnum and humanoid:GetState() ~= stEnum then
                        humanoid:ChangeState(stEnum)
                    end
                end
            end)
        end
    end
end)

