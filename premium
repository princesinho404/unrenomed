local function limparNomeArquivo(nome)
    return string.gsub(nome, "[%s%p]", "_")
end

local function salvarArquivoRota(nomeRota, tabelaDados)
    if writefile then
        pcall(function()
            tabelaDados.nomeRota = nomeRota
            local json = HttpService:JSONEncode(tabelaDados)
            local caminho = NOME_PASTA .. "/" .. limparNomeArquivo(nomeRota) .. ".json"
            writefile(caminho, json)
        end)
