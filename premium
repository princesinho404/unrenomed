        local validos = obterTrofeusColetaveis()
        for _, trofeu in ipairs(validos) do
            local prompt = trofeu:FindFirstChildWhichIsA("ProximityPrompt", true)
            local alvo = trofeu:IsA("BasePart") and trofeu or trofeu:FindFirstChildWhichIsA("BasePart")
            local char = LocalPlayer.Character
            if prompt and prompt.Enabled and alvo and char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = alvo.CFrame * CFrame.new(0, 3, 0)
                task.wait(0.4)
                if fireproximityprompt then fireproximityprompt(prompt) end
                task.wait(0.4)
            end
        end
        farmTrofeuRunning = false
    end)
end

local function iniciarFarmContinuo()
    task.spawn(function()
        while farmAtivo do
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then task.wait(0.5) continue end

            if modoSelecionado == "Coletar Grama" then
                if not pegarFoice() then
                    task.wait(1)
                    continue
                end

                local gramasPasta = workspace:FindFirstChild("Map") and workspace.Map.Sistemas.Jobs["Cortar Grama"].Gramas
                if gramasPasta then
                    for _, grama in ipairs(gramasPasta:GetChildren()) do
                        if not farmAtivo or modoSelecionado ~= "Coletar Grama" then break end
                        
                        local prompt = grama:FindFirstChildWhichIsA("ProximityPrompt", true)
                        local alvo = grama:IsA("BasePart") and grama or grama:FindFirstChildWhichIsA("BasePart")
                        
                        if alvo and alvo.Transparency < 0.9 and prompt and prompt.Enabled then
                            hrp.CFrame = alvo.CFrame * CFrame.new(0, 3, 0)
                            task.wait(1.5)
                            if prompt.Enabled and fireproximityprompt then 
                                fireproximityprompt(prompt) 
                            end
                        end
                    end
                end
                
            elseif modoSelecionado == "Coletar Lixo" then
                local jobLixo = workspace:FindFirstChild("Map") and workspace.Map.Sistemas.Jobs["Recolher Lixo"]
                local lixoPasta = jobLixo and jobLixo:FindFirstChild("Lixos")
                local lixeirasPasta = jobLixo and jobLixo:FindFirstChild("Lixeiras")
                
                local temLixoInventario = (char:FindFirstChild("Lixo") or LocalPlayer.Backpack:FindFirstChild("Lixo"))
                
                if temLixoInventario and lixeirasPasta then
                    local lixeiraAlvo = lixeirasPasta:FindFirstChildWhichIsA("BasePart", true)
                    if lixeiraAlvo then
                        temFerramenta("Lixo")
                        hrp.CFrame = lixeiraAlvo.CFrame * CFrame.new(0, 3, 0)
                        task.wait(0.5)
                        local prompt = lixeiraAlvo:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt and prompt.Enabled and fireproximityprompt then 
                            fireproximityprompt(prompt) 
                        end
                    end
                elseif lixoPasta then
                    for _, lixo in ipairs(lixoPasta:GetChildren()) do
                        if not farmAtivo or modoSelecionado ~= "Coletar Lixo" or temLixoInventario then break end
                        
                        if lixo.Name == "Lixo" then
                            local prompt = lixo:FindFirstChildWhichIsA("ProximityPrompt", true)
                            local alvo = lixo:IsA("BasePart") and lixo or lixo:FindFirstChildWhichIsA("BasePart")
                            
                            if alvo and prompt and prompt.Enabled then
                                hrp.CFrame = alvo.CFrame * CFrame.new(0, 3, 0)
                                task.wait(1)
                                if prompt.Enabled and fireproximityprompt then 
                                    fireproximityprompt(prompt) 
                                end
                                break
                            end
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

