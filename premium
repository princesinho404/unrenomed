local function travarCameraCima()
    if conexaoCamera then conexaoCamera:Disconnect() end
    Camera.CameraType = Enum.CameraType.Scriptable
    conexaoCamera = RunService.RenderStepped:Connect(function()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then Camera.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 15, 0), hrp.Position) end
