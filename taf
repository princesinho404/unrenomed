local function CriarBotaoGenerico(Parent, Titulo, TextoCopiar, Altura, CorFundo, CorBorda)
	local Botao = Instance.new("TextButton")
	Botao.Parent = Parent
	Botao.Size = UDim2.new(1, -20, 0, Altura)
	Botao.BackgroundColor3 = CorFundo or Color3.fromRGB(36, 39, 48)
	Botao.Text = "📋 " .. Titulo
	Botao.Font = Enum.Font.GothamBold
	Botao.TextSize = 11
	Botao.TextColor3 = Color3.new(1,1,1)
 
	local Corner = Instance.new("UICorner")
	Corner.Parent = Botao
	Corner.CornerRadius = UDim.new(0, 6)
 
	local Stroke = Instance.new("UIStroke")
	Stroke.Thickness = 1
	Stroke.Color = CorBorda or Color3.fromRGB(55, 59, 72)
	Stroke.Parent = Botao
 
	CreateHoverEffect(Botao, Stroke, Botao.BackgroundColor3, Color3.fromRGB(48, 52, 64), Color3.fromRGB(24, 26, 32), Stroke.Color, Color3.fromRGB(80, 85, 105))
 
	Botao.MouseButton1Click:Connect(function()
		setclipboard(TextoCopiar)
		Botao.Text = "✅ Copiado!"
		task.wait(1)
		Botao.Text = "📋 " .. Titulo
	end)
	return Botao
end

