-- Arrastar Janela Principal
local Dragging, DragStart, StartPos
Top.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		Dragging = true
		DragStart = input.Position
		StartPos = Main.Position
	end
end)
Top.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end
end)
UIS.InputChanged:Connect(function(input)
	if Dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local Delta = input.Position - DragStart
		Main.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + Delta.X, StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y)
	end
end)
 
-- Arrastar Botão de Abrir (+)
local DragButton, ButtonStart, ButtonPos
OpenButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		DragButton = true
		ButtonStart = input.Position
		ButtonPos = OpenButton.Position
	end
end)
OpenButton.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then DragButton = false end
end)
UIS.InputChanged:Connect(function(input)
	if DragButton and input.UserInputType == Enum.UserInputType.MouseMovement then
		local Delta = input.Position - ButtonStart
		OpenButton.Position = UDim2.new(ButtonPos.X.Scale, ButtonPos.X.Offset + Delta.X, ButtonPos.Y.Scale, ButtonPos.Y.Offset + Delta.Y)
	end
end)
 
